# Dexter Bot Configuration
# Copy this file to .env and fill in the values

# Telegram Bot Token - get from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Patron chat IDs (comma-separated list of Telegram chat IDs for /reload and /status)
# Example: PATRON_CHAT_IDS=12345678,87654321
PATRON_CHAT_IDS=

# Gemini API key - get from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram ID Hash Salt - must be a strong random secret for privacy protection
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_ID_HASH_SALT=your_strong_random_salt_here